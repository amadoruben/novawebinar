# Copie para .env e preencha. Nunca versione o .env com valores reais.

# Supabase (cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase (servidor)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transcrição com tempos por palavra
ASSEMBLYAI_API_KEY=

# IA própria (geração e análise das interações do webinar)
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-5.6-luna
# Opcional: base alternativa compatível com a API da OpenAI
AI_BASE_URL=
# Modelo de imagens (capas, oferta, produto); por omissão gpt-image-1
AI_IMAGE_MODEL=

# Saldo de IA: custo real do fornecedor (USD) + margem. Sem os preços de texto, nada é cobrado.
# Copie os valores da página de preços do seu fornecedor para o modelo em AI_CHAT_MODEL.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_PER_IMAGE=
TRANSCRIPTION_PRICE_PER_HOUR=
AI_MARGIN=0.4

# Opcional: domínio público das salas e subdomínio de administração
VITE_PUBLIC_APP_URL=
VITE_ADMIN_HOST=
VITE_PUBLIC_HOSTS=

# Opcional: "off" desliga o motor interno da fila de trabalhos. Usar só quando a fila
# é empurrada por uma chamada agendada a /api/public/run-jobs (alojamento serverless).
JOB_TICKER=
